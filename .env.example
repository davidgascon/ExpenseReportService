# Copy this file to .env and fill in real values before starting the server.
# Generate a strong random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-long-random-string

# Port the service listens on (bind to localhost and put nginx in front for HTTPS)
PORT=3000

# Set to "true" only once the site is served over HTTPS (required for secure cookies)
COOKIE_SECURE=false

# Where the SQLite database and uploaded receipt files are stored
DATA_DIR=./data

# Optional: adds an "I'm not a robot" checkbox to the registration page.
# Leave both blank to leave it off (registration works normally either way).
# Get a free site key + secret key at https://www.google.com/recaptcha/admin
# - create a new site, choose "reCAPTCHA v2" > "I'm not a robot" Checkbox,
# and add your domain (e.g. gasconhome.com).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: emails each user a copy of their receipt(s) right after upload,
# if they've set an email address on their Account page. Leave SMTP_HOST
# blank to leave it off entirely (uploads work normally either way).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
