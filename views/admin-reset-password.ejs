<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password — Expense Reports</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/topbar') %>
  <div class="container">
    <div class="card">
      <h2 style="margin-top:0;">Reset password for <%= targetUser.display_name %></h2>
      <p class="small muted" style="margin-top:-6px;">
        This sets a brand new password for <strong><%= targetUser.username %></strong> without needing their old
        one. Let them know the new password through some other channel — it isn't emailed anywhere.
      </p>
      <% if (error) { %><div class="error-banner"><%= error %></div><% } %>
      <form method="POST" action="/admin/users/<%= targetUser.id %>/reset-password">
        <label for="new_password">New password</label>
        <input type="password" id="new_password" name="new_password" minlength="4" required>

        <label for="confirm_password">Confirm new password</label>
        <input type="password" id="confirm_password" name="confirm_password" minlength="4" required>

        <div class="actions-row">
          <button type="submit">Set New Password</button>
          <a href="/admin" class="btn secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/theme.js"></script>
</body>
</html>
