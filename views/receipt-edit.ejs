<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Receipt — Expense Reports</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/topbar') %>
  <div class="container">
    <div class="card">
      <h2 style="margin-top:0;">
        Edit receipt
        <% if (queueTotal > 1) { %><span class="field-hint" style="display:inline; font-weight:400;">— receipt <%= queuePosition %> of <%= queueTotal %></span><% } %>
      </h2>
      <% if (error) { %><div class="error-banner"><%= error %></div><% } %>

      <div class="actions-row" style="margin-bottom:14px;">
        <a class="file-link js-view-file" href="/receipts/<%= receipt.id %>/file" data-file-name="<%= receipt.original_name || 'Receipt' %>" data-file-type="<%= /\.(jpe?g|png|gif|webp|bmp)$/i.test(receipt.original_name || '') ? 'image' : 'pdf' %>" target="_blank">View original file</a>
      </div>

      <form method="POST" action="/receipts/<%= receipt.id %>/edit">
        <input type="hidden" name="return_to" value="<%= returnTo %>">
        <input type="hidden" name="queue" value="<%= queue %>">
        <input type="hidden" name="queue_total" value="<%= queueTotal %>">

        <label for="receipt_date">Date</label>
        <input type="date" id="receipt_date" name="receipt_date" value="<%= receipt.receipt_date || '' %>">

        <label for="total">Total ($)</label>
        <input type="number" id="total" name="total" step="0.01" min="0" value="<%= receipt.total ? receipt.total.toFixed(2) : '' %>" required>

        <label class="field-hint" style="display:block; margin-bottom:4px;">Expense category <span style="display:inline;">(which column this total goes into on the exported spreadsheet)</span></label>
        <div class="radio-group">
          <% expenseCategories.forEach(function(c) { %>
            <label class="radio-option">
              <input type="radio" name="expense_category" value="<%= c.key %>" <%= (receipt.expense_category || 'local_entertainment') === c.key ? 'checked' : '' %>>
              <%= c.label %><% if (c.hint) { %> <span class="field-hint" style="display:inline;">(<%= c.hint %>)</span><% } %>
            </label>
          <% }); %>
        </div>

        <label for="project_id">Project <span class="field-hint" style="display:inline;">(shared list — picking one fills in a default GL code below; not itself used on the exported spreadsheet)</span></label>
        <select id="project_id" name="project_id" style="width:100%;">
          <option value="">— No project —</option>
          <% projects.forEach(function(p) { %>
            <option value="<%= p.id %>" data-number="<%= p.number %>" <%= receipt.project_id === p.id ? 'selected' : '' %>><%= p.number %> - <%= p.name %></option>
          <% }); %>
          <option value="new">+ Add a new project…</option>
        </select>
        <% if (!receipt.project_id && receipt.project_name) { %>
          <p class="field-hint">Previously entered: "<%= receipt.project_name %>" — kept as-is unless you pick a project above.</p>
        <% } %>

        <div id="newProjectFields" class="new-project-fields">
          <label for="new_project_number">New project number</label>
          <input type="text" id="new_project_number" name="new_project_number" placeholder="e.g. 86259065">

          <label for="new_project_name">New project name</label>
          <input type="text" id="new_project_name" name="new_project_name" placeholder="e.g. Kokusai">
        </div>

        <label for="gl_code" style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
          GL code <span class="field-hint" style="display:inline;">(this is what gets put on the exported spreadsheet)</span>
          <button type="button" id="glInfoBtn" class="gl-info-btn" aria-label="GL code format info" title="GL code format info">ⓘ</button>
        </label>
        <div id="glInfoBox" class="gl-info-box">
          <p><strong>Format:</strong> Project Number - Geo Code - Department - Category</p>
          <p class="small muted">Geo Code is typically <strong>000</strong>.</p>
          <p class="small muted" style="margin-bottom:4px;">Category:</p>
          <ul class="gl-category-list">
            <li><strong>00</strong> — Labor</li>
            <li><strong>60</strong> — Material costs</li>
            <li><strong>61</strong> — Small tools/consumables</li>
            <li><strong>65</strong> — Equipment</li>
            <li><strong>86</strong> — Parking/mileage</li>
            <li><strong>90</strong> — Other costs</li>
          </ul>
        </div>
        <input type="text" id="gl_code" name="gl_code" value="<%= receipt.gl_code || '' %>" placeholder="e.g. 86259049-000-95-90">

        <label for="description">Description <span class="field-hint" style="display:inline;">(this is what gets put on the exported spreadsheet)</span></label>
        <input type="text" id="description" name="description" value="<%= receipt.description || '' %>" placeholder="Project Lunch: (list who attended)">

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" placeholder="Purpose of the expense, client name, etc."><%= receipt.notes || '' %></textarea>

        <div class="actions-row">
          <button type="submit"><%= queue ? 'Save & Next' : 'Save Changes' %></button>
          <a href="<%= returnTo === 'report' && receipt.report_id ? '/reports/' + receipt.report_id : '/receipts' %>" class="btn secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/theme.js"></script>
  <script src="/js/filePreview.js"></script>
  <script src="/js/receiptEdit.js"></script>
  <% if (!receipt.receipt_date) { %>
    <script>
      // A receipt with no date yet has never been through this form before
      // (freshly uploaded) - open the file preview automatically so there's
      // something to fill in details *from* without an extra click.
      document.addEventListener('DOMContentLoaded', function () {
        var link = document.querySelector('.js-view-file');
        if (link) link.click();
      });
    </script>
  <% } %>
</body>
</html>
