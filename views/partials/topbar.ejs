<%- include('broadcast-banner') %>
<div class="topbar">
  <a class="brand" href="/reports">📋 Expense Reports</a>
  <nav class="top-nav">
    <a href="/reports">My Reports</a>
    <a href="/receipts">Receipt Inbox</a>
    <% if (currentUser && currentUser.is_admin) { %>
      <a href="/admin">Admin</a>
    <% } %>
  </nav>
  <div class="user-info">
    <a href="/receipts" class="btn">+ Add Receipt</a>
    <button type="button" id="themeToggle" class="secondary theme-toggle" onclick="toggleTheme()">
      <span class="theme-toggle-icon">🌙</span><span class="theme-toggle-label"> Dark</span>
    </button>
    <a href="/account" class="topbar-username" style="color:inherit; text-decoration:none;">
      <%= currentUser.display_name %>
      <% if (missingProfileFields && missingProfileFields.length > 0) { %>
        <span class="badge missing-info" title="Missing: <%= missingProfileFields.map(function(f) { return f.label; }).join(', ') %> (optional but recommended)">!</span>
      <% } %>
    </a>
    <form method="POST" action="/logout" style="margin:0;">
      <button type="submit" class="secondary" style="padding:4px 10px;">Log out</button>
    </form>
  </div>
</div>
