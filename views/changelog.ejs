<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Changelog — Expense Reports</title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <%- include('partials/topbar') %>
  <% } else { %>
    <%- include('partials/broadcast-banner') %>
  <% } %>
  <div class="container">
    <div class="card">
      <h2 style="margin-top:0;">Changelog</h2>
      <% changelog.forEach(function(entry) { %>
        <div style="margin-bottom:18px;">
          <h3 style="margin-bottom:4px;">
            v<%= entry.version %> <span class="muted small" style="font-weight:400;"><%= entry.date %></span>
          </h3>
          <ul style="margin-top:4px;">
            <% entry.highlights.forEach(function(h) { %>
              <li><%= h %></li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    </div>
  </div>
  <%- include('partials/footer') %>
  <script src="/js/theme.js"></script>
</body>
</html>
